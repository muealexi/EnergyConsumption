# Copy to .env and fill in your values (never commit .env).
# Wiener Netze Smart Meter API — https://api-portal.wienerstadtwerke.at/

WN_CLIENT_ID=your-client-id-from-smartmeter-business-portal
WN_CLIENT_SECRET=your-client-secret
WN_API_KEY=your-api-key-from-developer-portal
# Full 33-character Zählpunktnummer
WN_METER_ID=AT0010000000000000001000000000000
